{{!
    @template format_learningjourney/portal_contact

    Contact / talk-to-us form wrapped in Bezeq-style card.
}}
<div class="lj-portal-shell lj-portal-contact">
    <h1 class="lj-portal-heading h3">{{heading}}</h1>
    <div class="lj-portal-card lj-portal-card--contact">
        <p class="lj-portal-card__lead">{{lead}}</p>
        <div class="lj-portal-contact__form">
            {{{formhtml}}}
        </div>
    </div>
</div>
