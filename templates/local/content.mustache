{{!
    @template format_learningjourney/local/content

    Same as core course format content, but section partials resolve to this format so section
    images and dates render. Core template: core_courseformat/local/content.
}}
<div id="course-format-{{uniqid}}" class="{{#ljisediting}}format-learningjourney-mode-editing{{/ljisediting}}{{^ljisediting}}format-learningjourney-mode-view{{/ljisediting}}{{#ljhascoursebanner}} lj-has-course-banner{{/ljhascoursebanner}}">
    <h2 class="accesshide">{{{title}}}</h2>
    {{{completionhelp}}}
    {{#ljhascoursebanner}}
    <div class="lj-course-banner" data-for="learningjourney_course_banner">
        <img src="{{{ljcoursebannerurl}}}" alt="{{ljcoursebanneralt}}" class="lj-course-banner__img"/>
        <div class="lj-course-banner__overlay">
            <h1 class="lj-course-banner__title">{{ljcoursename}}</h1>
        </div>
    </div>
    {{/ljhascoursebanner}}
    {{#ljpath.enabled}}
    <section class="lj-path" aria-label="{{ljpath.label}}">
        <div class="lj-path__head">
            <h2 class="lj-path__title">{{ljpath.label}}</h2>
            <p class="lj-path__info">{{ljpath.infolabel}}</p>
        </div>
        <div class="lj-path__bar"
             role="progressbar"
             aria-valuenow="{{ljpath.percent}}"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-valuetext="{{ljpath.valuetext}}">
            <span class="lj-path__done" style="width: {{ljpath.percent}}%;"></span>
        </div>
        <div class="lj-path__legend">
            <span class="lj-path__legend-item lj-path__legend-item--done">
                <span class="lj-path__swatch" aria-hidden="true"></span>
                {{ljpath.donelabel}} {{ljpath.percent}}%
            </span>
            <span class="lj-path__legend-item lj-path__legend-item--left">
                <span class="lj-path__swatch" aria-hidden="true"></span>
                {{ljpath.leftlabel}} {{ljpath.remainingpercent}}%
            </span>
        </div>
        <p class="lj-path__count">{{ljpath.countlabel}}</p>
    </section>
    {{/ljpath.enabled}}
    <ul class="{{format}} format-learningjourney-sectionlist {{#ljsectionlayoutgrid}}lj-layout-grid{{/ljsectionlayoutgrid}}{{^ljsectionlayoutgrid}}lj-layout-list{{/ljsectionlayoutgrid}} lj-grid-cols-{{ljgridcols}}" data-for="course_sectionlist">
        {{#ljshowsection0}}
            {{#initialsection}}
                {{$ core_courseformat/local/content/section }}
                    {{> format_learningjourney/local/content/section }}
                {{/ core_courseformat/local/content/section }}
            {{/initialsection}}
        {{/ljshowsection0}}
        {{#sections}}
            {{$ core_courseformat/local/content/section }}
                {{> format_learningjourney/local/content/section }}
            {{/ core_courseformat/local/content/section }}
        {{/sections}}
    </ul>
    {{#hasnavigation}}
    <div class="single-section lj-single-section{{#ljhassectioncover}} lj-single-section--has-cover{{/ljhassectioncover}}">
        {{#ljhassectioncover}}
        <div class="lj-section-cover" data-for="learningjourney_cover">
            <img src="{{{ljsectioncoverurl}}}" alt="{{ljsectioncoveralt}}" class="lj-section-cover__img"/>
        </div>
        {{/ljhassectioncover}}
        {{#sectionnavigation}}
            {{$ core_courseformat/local/content/sectionnavigation }}
                {{> format_learningjourney/local/content/sectionnavigation }}
            {{/ core_courseformat/local/content/sectionnavigation }}
        {{/sectionnavigation}}
        <ul class="{{format}}">
        {{#singlesection}}
            {{$ core_courseformat/local/content/section }}
                {{> format_learningjourney/local/content/section }}
            {{/ core_courseformat/local/content/section }}
        {{/singlesection}}
        </ul>
        {{#sectionselector}}
            {{$ core_courseformat/local/content/sectionselector }}
                {{> format_learningjourney/local/content/sectionselector }}
            {{/ core_courseformat/local/content/sectionselector }}
        {{/sectionselector}}
    </div>
    {{/hasnavigation}}
    {{#numsections}}
        {{^singlesection}}
            {{$ core_courseformat/local/content/addsection}}
                {{> core_courseformat/local/content/addsection}}
            {{/ core_courseformat/local/content/addsection}}
        {{/singlesection}}
    {{/numsections}}
    {{#bulkedittools}}
        {{$ core_courseformat/local/content/bulkedittools}}
            {{> core_courseformat/local/content/bulkedittools}}
        {{/ core_courseformat/local/content/bulkedittools}}
    {{/bulkedittools}}
</div>
{{#js}}
require(['core_courseformat/local/content'], function(component) {
    component.init(
        'page', {}, {{sectionreturn}}, {{#pagesectionid}}{{.}}{{/pagesectionid}}{{^pagesectionid}}null{{/pagesectionid}}
    );
});
{{/js}}
